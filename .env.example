# ---------------------------------------------------------------------------
# KandyVerse environment
# Copy to .env.local and fill in what you have. Every integration degrades
# gracefully: the app runs with no keys at all using the bundled seed data.
# ---------------------------------------------------------------------------

# Public URL of the deployment (used for metadata, sitemap and auth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Postgres / Drizzle ----------------------------------------------------
# Supabase Dashboard → Project Settings → Database → Connection string (URI).
# Use the pooler host on port 5432 (session mode) or the direct connection.
# Server-only. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Auth / Storage (optional) ------------------------------------
# Dashboard → Project Settings → API. The anon key is safe for the browser;
# catalogue reads/writes go through Drizzle on the server instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Editorial admin -------------------------------------------------------
# A signed HttpOnly cookie is issued after login. Set either a plain password
# for local development or a SHA-256 hash in production.
ADMIN_EMAIL=editor@example.com
ADMIN_PASSWORD=
# printf '%s' 'your-password' | sha256sum
ADMIN_PASSWORD_SHA256=
# Optional: pin the HMAC secret. Defaults to a hash of ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# --- Google Maps Platform (optional) ---------------------------------------
# Two separate keys are used:
#   * NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is a browser key for Photorealistic 3D
#     Tiles. Restrict it by HTTP referrer.
#   * GOOGLE_MAPS_SERVER_API_KEY is a server-only key for the Routes API.
#     Restrict it by API and IP. Never prefix it with NEXT_PUBLIC_.
# Without keys the app uses CARTO/OSM imagery, procedural landmarks and
# labelled distance-based estimates.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# --- OpenStreetMap / Overpass (optional) -----------------------------------
# Live nearby services try the configured endpoint first, then the public
# overpass-api.de and overpass.osm.ch mirrors. Override this if you run your
# own instance or need a different mirror.
OVERPASS_ENDPOINT=https://overpass.osm.ch/api/interpreter

# --- Cesium ion (optional) -------------------------------------------------
# Enables Cesium World Terrain. Without it the scene uses the ellipsoid.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# --- OpenAI (optional) -----------------------------------------------------
# The assistant uses grounded database tools. Without a key it runs a
# deterministic retrieval/planner engine and says so in the UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
