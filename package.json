{
  "name": "kandyverse",
  "version": "1.0.0",
  "private": true,
  "description": "KandyVerse — Explore Kandy Beyond the Map. Immersive 3D digital tourism and smart city exploration platform.",
  "scripts": {
    "setup:assets": "node scripts/setup-assets.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "predev": "npm run setup:assets",
    "dev": "next dev",
    "prebuild": "npm run setup:assets",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:sql": "node scripts/generate-seed-sql.mjs",
    "db:bootstrap": "node scripts/db-bootstrap.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:setup": "npm run db:bootstrap && npm run db:migrate && npm run db:seed",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@turf/bearing": "^7.2.0",
    "@turf/distance": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "cesium": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^12.23.12",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.544.0",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.20",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
